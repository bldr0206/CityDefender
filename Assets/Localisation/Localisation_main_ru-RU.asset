  m_TableData:
  - m_Id: 741962022912
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C \u0431\u0443\u0442\u044B\u043B\u043A\u0443
      +$25"
    m_Metadata:
      m_Items: []
  - m_Id: 698970406912
    m_Localized: "\u0410\u0440\u0435\u043D\u0434\u043E\u0432\u0430\u0442\u044C \u0410\u0433\u0435\u043D\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 18138398720
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u0440\u0430\u0431\u043E\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 43564614680576
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E
      \u0442\u0435\u0431\u044F, \u0441\u043E\u0438\u0441\u043A\u0430\u0442\u0435\u043B\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 43797570519040
    m_Localized: "\u042F - HR \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438
      EVERYTHING POSSIBLE inc., \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0441\u044C
      \u043F\u0435\u0440\u0432\u0438\u0447\u043D\u044B\u043C \u043E\u0442\u0431\u043E\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 43966911348736
    m_Localized: "\u0427\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435 \u043D\u0430
      \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435
      \u0438 \u043F\u0440\u043E\u0439\u0442\u0438 \u0434\u0430\u043B\u0435\u0435,
      \u0442\u044B \u0434\u043E\u043B\u0436\u0435\u043D \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0441\u0432\u043E\u0435 CV"
    m_Metadata:
      m_Items: []
  - m_Id: 44662775742464
    m_Localized: "\u0411\u0435\u0437 CV \u043D\u0430\u043C \u043D\u0435 \u043E \u0447\u0435\u043C
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u043F\u0440\u0438\u043D\u0435\u0441\u0438
      CV..."
    m_Metadata:
      m_Items: []
  - m_Id: 44966623707136
    m_Localized: "\u0410 \u0433\u0434\u0435 \u044F \u043D\u0430\u0439\u0434\u0443
      \u044D\u0442\u043E CV? \u042F \u0436\u0435 \u0434\u0430\u0436\u0435 \u043D\u0435
      \u0443\u043C\u0435\u044E \u043F\u0438\u0441\u0430\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 56506546520064
    m_Localized: "\u0412\u0437\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 56771228073984
    m_Localized: "\u041F\u0443\u0441\u0442\u0430\u044F \u0431\u0443\u0442\u044B\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 152976883712
    m_Localized: "\u0414\u0430\u043B\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 858156826624
    m_Localized: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 63779922640896
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 378817430552576
    m_Localized: "\u042F \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0447\u0442\u043E-\u0442\u043E
      \u0432\u0438\u0436\u0443... \u043D\u043E \u0442\u0443\u0434\u0430 \u0442\u0430\u043A
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u0434\u043E\u0431\u0435\u0440\u0435\u0448\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 378995248070656
    m_Localized: "\u041D\u0430\u0434\u043E \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C
      \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0442\u0443\u0434\u0430
      \u0437\u0430\u043B\u0435\u0437\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 379283665190912
    m_Localized: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F \u044F \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B!
      \u043D\u043E \u0441\u043F\u0435\u0440\u0432\u0430 \u043D\u0443\u0436\u043D\u043E
      \u0440\u0430\u0437\u0434\u043E\u0431\u044B\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0434\u0435\u043D\u0435\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 380431813967872
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u0433\u0434\u0435 \u043C\u043E\u0436\u043D\u043E
      \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 403554798010368
    m_Localized: "\u041E \u0431\u043E\u0436\u0435 \u043A\u0430\u043A \u0436\u0435
      \u0434\u043E\u0441\u0442\u0430\u043B\u0430 \u044D\u0442\u0430 \u043D\u0438\u0449\u0435\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 403760176300032
    m_Localized: "\u041F\u043E\u0440\u0430 \u043C\u043D\u0435 \u043D\u0430\u0439\u0442\u0438
      \u0440\u0430\u0431\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 403995468365824
    m_Localized: "\u041F\u043E\u0439\u0434\u0443 \u043F\u043E\u043F\u044B\u0442\u0430\u044E
      \u0441\u0447\u0430\u0441\u0442\u044C\u0435, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
      \u0443 \u043D\u0438\u0445 \u0435\u0441\u0442\u044C \u0434\u043B\u044F \u043C\u0435\u043D\u044F
      \u0440\u0430\u0431\u043E\u0442\u0435\u043D\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 427547118665728
    m_Localized: "\u0421\u0434\u0430\u0439 \u0431\u0443\u0442\u044B\u043B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 429457989042176
    m_Localized: "\u0412\u043E\u0442 \u043E\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 429681671274496
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u044D\u0442\u043E\u043C\u0443
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0443, \u044F \u0441\u043C\u043E\u0433\u0443
      \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0434\u0435\u043D\u0435\u0433\n"
    m_Metadata:
      m_Items: []
  - m_Id: 429777905385472
    m_Localized: "\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0438\u0441\u043A\u0430\u0442\u044C
      \u0431\u0443\u0442\u044B\u043B\u043A\u0438 \u0432 \u043E\u043A\u043E\u043B\u0438\u0446\u0435,
      \u044F \u0432\u0440\u043E\u0434\u0435 \u0432\u0438\u0434\u0435\u043B \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 435558788759552
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u0443 \u043C\u0435\u043D\u044F
      \u0435\u0441\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438! "
    m_Metadata:
      m_Items: []
  - m_Id: 435723968839680
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u044F \u043C\u043E\u0433\u0443
      \u043D\u0430\u043D\u044F\u0442\u044C \u0430\u0433\u0435\u043D\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2569536205389824
    m_Localized: "\u0418 \u043E\u043D \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0442
      \u044D\u0442\u0438 \u0434\u0443\u0440\u0430\u0446\u043A\u0438\u0435 \u043A\u043E\u0440\u043E\u0431\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2569656732909568
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u0430\u0433\u0435\u043D\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2579951102623744
    m_Localized: "\u0420\u0430\u0437\u0431\u0435\u0439 \u043A\u043E\u0440\u043E\u0431\u043A\u0438
      \u0443 \u043B\u0438\u0444\u0442\u0430"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
